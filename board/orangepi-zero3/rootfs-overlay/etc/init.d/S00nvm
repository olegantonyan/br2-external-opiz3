#!/bin/sh

wait_mtd() {
	i=0
	while ! grep -q "\"$1\"" /proc/mtd && [ $i -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	grep -q "\"$1\"" /proc/mtd
}

start() {
	printf "Mounting /mnt/nvm: "
	if wait_mtd nvm && mount -t jffs2 -o noatime mtd:nvm /mnt/nvm; then
		echo "OK"
	else
		mount -t tmpfs -o mode=0755 tmpfs /mnt/nvm
		echo "FAIL (tmpfs)"
	fi
	mkdir -p -m 700 /mnt/nvm/dropbear /mnt/nvm/bluetooth
	[ -e /mnt/nvm/wpa_supplicant.conf ] || install -m 600 /etc/wpa_supplicant.conf.template /mnt/nvm/wpa_supplicant.conf
}

stop() {
	printf "Unmounting /mnt/nvm: "
	umount /mnt/nvm && echo "OK" || echo "FAIL"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
