#!/bin/sh

wait_for() {
	i=0
	while [ ! -e "$1" ] && [ $i -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	[ -e "$1" ]
}

start() {
	printf "Starting UWE5622: "
	modprobe sprdwl_ng && wait_for /sys/class/net/wlan0 || { echo "FAIL (wifi)"; return 1; }
	modprobe sprdbt_tty && wait_for /dev/ttyBT0 && hciattach_opi -s 1500000 /dev/ttyBT0 sprd >/dev/null 2>&1 && wait_for /sys/class/bluetooth/hci0 || { echo "FAIL (bt)"; return 1; }
	for r in /sys/class/rfkill/rfkill*; do
		[ "$(cat "$r/type")" = bluetooth ] && echo 0 > "$r/soft"
	done
	echo "OK"
}

stop() {
	printf "Stopping UWE5622: "
	killall hciattach_opi 2>/dev/null
	modprobe -r sprdbt_tty sprdwl_ng uwe5622_bsp_sdio
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
