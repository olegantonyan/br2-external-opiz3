config BR2_PACKAGE_UWE5622
	bool "uwe5622"
	depends on BR2_LINUX_KERNEL
	help
	  Unisoc UWE5622 WiFi/Bluetooth out-of-tree kernel drivers
	  (uwe5622_bsp_sdio, sprdwl_ng, sprdbt_tty), Allwinner variant.

	  https://github.com/armbian/uwe5622

comment "uwe5622 needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL
