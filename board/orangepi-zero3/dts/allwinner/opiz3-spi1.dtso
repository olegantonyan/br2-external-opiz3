/dts-v1/;
/plugin/;

&{/aliases} {
	spi0 = "/soc/spi@5010000";
	spi1 = "/soc/spi@5011000";
};

&pio {
	opiz3_spi1_pins: opiz3-spi1-pins {
		pins = "PH5", "PH6", "PH7", "PH8", "PH9";
		function = "spi1";
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&opiz3_spi1_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};

	spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};
};
